<?xml version="1.0"?>
<!-- GENERATED by scripts/common/gen_configs.py from config/rig.yaml. Do not edit. -->
<sdf version="1.6">
  <model name="iris_evtol">
    <include>
      <uri>model://iris</uri>
    </include>
    <link name="imu_link">
      <pose>0.12 0.0 -0.06 3.141593 0.0 0.0</pose>
      <gravity>true</gravity>
      <inertial>
        <mass>0.35</mass>
        <inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
      </inertial>
      <!-- visual only: no collision, so the rig can never touch the world -->
      <visual name="rig_visual">
        <geometry><box><size>0.08 0.08 0.06</size></box></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material>
      </visual>
      <!-- IMU: deliberately NOISE-FREE. Noise is injected afterwards by
           scripts/common/imu_noise.py so that one recorded flight can be
           replayed with any IMU grade (Stage 4). -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <plugin name="imu_ros" filename="libgazebo_ros_imu_sensor.so">
          <topicName>/livox/imu</topicName>
          <bodyName>imu_link</bodyName>
          <updateRateHZ>200</updateRateHZ>
          <gaussianNoise>0.0</gaussianNoise>
          <xyzOffset>0 0 0</xyzOffset>
          <rpyOffset>0 0 0</rpyOffset>
          <frameName>imu_link</frameName>
          <initialOrientationAsReference>false</initialOrientationAsReference>
        </plugin>
      </sensor>

      <!-- LiDAR: Mid-360 scan pattern. publish_pointcloud_type 3 = Livox CustomMsg,
           which the sim image patches to livox_ros_driver/CustomMsg. -->
      <sensor name="livox_mid360" type="ray">
        <pose>-0.011 -0.02329 0.04412 0.0 0.0 0.0</pose>
        <visualize>false</visualize>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <plugin name="livox_ros" filename="liblivox_laser_simulation.so">
          <ray>
            <scan>
              <horizontal><samples>100</samples><resolution>1</resolution>
                <min_angle>-3.1415926535897931</min_angle><max_angle>3.1415926535897931</max_angle></horizontal>
              <vertical><samples>50</samples><resolution>1</resolution>
                <min_angle>-3.1415926535897931</min_angle><max_angle>3.1415926535897931</max_angle></vertical>
            </scan>
            <range><min>0.1</min><max>40.0</max><resolution>1</resolution></range>
            <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
          </ray>
          <visualize>false</visualize>
          <samples>20000</samples>
          <downsample>1</downsample>
          <csv_file_name>mid360-real-centr.csv</csv_file_name>
          <publish_pointcloud_type>3</publish_pointcloud_type>
          <ros_topic>/livox/lidar</ros_topic>
          <frameName>livox_frame</frameName>
        </plugin>
      </sensor>

      <!-- Stereo pair. Topics: /stereo/left/image_raw, /stereo/right/image_raw -->
      <sensor name="stereo" type="multicamera">
        <pose>0.06 0.0 0.04 3.141593 -0.6109 0.0</pose>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <camera name="left">
          <pose>0 0.0 0 0 0 0</pose>
          <horizontal_fov>1.3736</horizontal_fov>
          <image><width>752</width><height>480</height><format>L8</format></image>
          <clip><near>0.05</near><far>300</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
        </camera>
        <camera name="right">
          <pose>0 -0.11 0 0 0 0</pose>
          <horizontal_fov>1.3736</horizontal_fov>
          <image><width>752</width><height>480</height><format>L8</format></image>
          <clip><near>0.05</near><far>300</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
        </camera>
        <!-- updateRate = 2x the sensor rate is a publish THROTTLE (minimum gap 1/(2f)).
             Without lockstep, Gazebo's rendering catch-up sometimes emits extra frames
             0-3 ms after the previous one (same or nearly the same stamp; ~3% of frames
             on the GPU). The throttle drops those and never touches a normal 1/f frame.
             0.0 (the guide's value) publishes every render. Gazebo's lockstep mode is
             no cure: it halves the Mid-360 rate (see docs/stage2_log.md). -->
        <plugin name="stereo_ros" filename="libgazebo_ros_multicamera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>40</updateRate>
          <cameraName>stereo</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>cam_left_optical</frameName>
          <hackBaseline>0.11</hackBaseline>
        </plugin>
      </sensor>
    </link>
    <!-- PX4's own composite models attach payloads with a zero-range revolute
         joint rather than a fixed joint; we follow the same pattern. -->
    <joint name="rig_mount" type="revolute">
      <child>imu_link</child>
      <parent>iris::base_link</parent>
      <axis><xyz>0 0 1</xyz><limit><upper>0</upper><lower>0</lower></limit></axis>
    </joint>
    <!-- Ground truth: exact pose of the IMU frame, the same frame every
         algorithm estimates. No lever-arm correction is ever needed. -->
    <plugin name="ground_truth" filename="libgazebo_ros_p3d.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>200</updateRate>
      <bodyName>imu_link</bodyName>
      <topicName>/ground_truth/odom</topicName>
      <gaussianNoise>0.0</gaussianNoise>
      <frameName>world</frameName>
      <xyzOffsets>0 0 0</xyzOffsets>
      <rpyOffsets>0 0 0</rpyOffsets>
    </plugin>
  </model>
</sdf>

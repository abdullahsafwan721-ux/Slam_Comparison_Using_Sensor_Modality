<?xml version="1.0"?>
<!-- GENERATED by scripts/common/gen_configs.py from config/rig.yaml. Do not edit. -->
<!-- Stage 2: a world plus the rig, spawned in its mounted (upside-down) attitude. -->
<launch>
  <arg name="world" default="/sim/worlds/room.world"/>
  <arg name="gui" default="true"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="false"/>
    <arg name="verbose" value="true"/>
  </include>
  <node name="spawn_rig" pkg="gazebo_ros" type="spawn_model" output="screen"
        args="-file /sim/models/evtol_rig_scripted/model.sdf -sdf -model evtol_rig
              -x 0.0 -y 0.0 -z 1.5 -R 3.14159265 -P 0.0 -Y 0.0"/>
</launch>

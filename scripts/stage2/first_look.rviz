Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz/Axes
      Name: livox_frame
      Enabled: true
      Length: 0.5
      Radius: 0.02
    - Class: rviz/PointCloud2
      Name: Mid-360 (/livox/points)
      Enabled: true
      Topic: /livox/points
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Value Bounds: true
      Decay Time: 0
      Queue Size: 2
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: livox_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 18
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.9
      Yaw: 0.8
      Name: Current View
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 800
  Width: 1100
  X: 60
  Y: 60
